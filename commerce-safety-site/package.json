{
  "name": "agent-integration-safety-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sync:artifacts": "node scripts/sync-demo-artifacts.mjs",
    "prebuild": "npm run sync:artifacts",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "api:dashboard": "node scripts/dashboard-api.mjs",
    "dev:dashboard": "node scripts/dev-dashboard.mjs",
    "serve:spa": "node scripts/serve-spa.mjs",
    "preview:local": "npm run build && node scripts/serve-spa.mjs --dir dist --host 127.0.0.1 --port 5175",
    "preview:dashboard": "npm run build && node scripts/dashboard-api.mjs --static-dir dist --host 127.0.0.1 --port 5175"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.1",
    "vite": "8.0.16"
  }
}
